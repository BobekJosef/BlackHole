#version 430 core
#extension GL_GOOGLE_include_directive : enable

// One step of the bloom down-sampling chain: the 13-tap filter of Jimenez, "Next Generation
// Post Processing in Call of Duty: Advanced Warfare" (SIGGRAPH 2014). Bilinear taps make it
// a 36-texel filter without aliasing. On the first step, a Karis average (weights
// 1 / (1 + luma) per 2x2 group) keeps single very bright pixels from flickering.

#include "common/color.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D uSource;            // twice the target size
layout(r11f_g11f_b10f, binding = 0) uniform writeonly image2D uTarget;

uniform bool uKarisAverage;

vec3 tap(vec2 uv, vec2 texel, float dx, float dy)
{
    return textureLod(uSource, uv + vec2(dx, dy) * texel, 0.0).rgb;
}

float karisWeight(vec3 color)
{
    return 1.0 / (1.0 + luminance(color));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uTarget);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 texel = 1.0 / vec2(textureSize(uSource, 0));

    vec3 a = tap(uv, texel, -2.0, 2.0);
    vec3 b = tap(uv, texel, 0.0, 2.0);
    vec3 c = tap(uv, texel, 2.0, 2.0);
    vec3 d = tap(uv, texel, -2.0, 0.0);
    vec3 e = tap(uv, texel, 0.0, 0.0);
    vec3 f = tap(uv, texel, 2.0, 0.0);
    vec3 g = tap(uv, texel, -2.0, -2.0);
    vec3 h = tap(uv, texel, 0.0, -2.0);
    vec3 i = tap(uv, texel, 2.0, -2.0);
    vec3 j = tap(uv, texel, -1.0, 1.0);
    vec3 k = tap(uv, texel, 1.0, 1.0);
    vec3 l = tap(uv, texel, -1.0, -1.0);
    vec3 m = tap(uv, texel, 1.0, -1.0);

    // Five overlapping 2x2 boxes: the centre one weighs 0.5, the four corner ones 0.125 each.
    vec3 boxes[5] = vec3[5]((j + k + l + m) * 0.25,
                            (a + b + d + e) * 0.25,
                            (b + c + e + f) * 0.25,
                            (d + e + g + h) * 0.25,
                            (e + f + h + i) * 0.25);
    float weights[5] = float[5](0.5, 0.125, 0.125, 0.125, 0.125);

    vec3 result = vec3(0.0);
    float totalWeight = 0.0;
    for (int box = 0; box < 5; ++box) {
        float w = uKarisAverage ? weights[box] * karisWeight(boxes[box]) : weights[box];
        result += w * boxes[box];
        totalWeight += w;
    }
    imageStore(uTarget, pixel, vec4(result / totalWeight, 1.0));
}
